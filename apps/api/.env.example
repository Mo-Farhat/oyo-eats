PORT=3000
# Neon: use the direct (non-pooled) connection string. pg-boss and advisory locks need session-level connections.
DATABASE_URL=postgresql://user:password@host/oyo_eats?sslmode=verify-full
# 32 random bytes, base64. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# HASH_KEY keys the phone and OTP hashes; ENCRYPTION_KEY encrypts phones, addresses, bank details, TOTP secrets.
# Changing either makes existing data unreadable. Production values live in Render's secret store.
HASH_KEY=
ENCRYPTION_KEY=
# Proxy hops in front of the API (1 on Render) so rate limits see the real client IP.
TRUST_PROXY=0
# Public base URL of this API (signed file links). Required in production.
PUBLIC_URL=http://localhost:3000

# Optional in development, required in production (docs/SETUP-PROVIDERS.md). Set all of a group or none.
# Cloudflare R2 file storage (otherwise local disk under UPLOAD_DIR, default .uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Notify.lk SMS (otherwise codes print to the console)
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=
# Google Routes API for road distances (otherwise straight-line x 1.3)
GOOGLE_ROUTES_API_KEY=
